# Telegram: бот від @BotFather і чат/група, куди падають заявки (бот має бути в групі)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890

# Google Sheets (необов'язково): сервісний акаунт з доступом «Редактор» до таблиці
SHEET_ID=
GOOGLE_CREDENTIALS=data/credentials.json

# ZIP-коди зони обслуговування: повні коди або префікси з * (787*). Порожньо — приймаємо всі
SERVICE_ZIPS=787*,786*,78610,78613

# Секрет для підпису токена форми (антиспам). Будь-який довгий випадковий рядок
SECRET_KEY=change-me-to-a-long-random-string

DB_PATH=data/leads.db
# Скільки заявок з однієї IP за годину
RATE_LIMIT_PER_HOUR=5

# Часовий пояс бізнесу (для часу в Telegram і таблиці)
TIMEZONE=America/Chicago
# 1 — якщо сайт стоїть за nginx/Cloudflare (IP береться з X-Forwarded-For)
TRUST_PROXY=0
